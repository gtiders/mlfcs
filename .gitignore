# ====================== 根目录：原有黑名单规则保留 ======================
# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.mlfcs-cache/
.omo
uv.lock

# Virtual environments
.venv
site/

# ====================== examples / examples-next / tutorial / tests：白名单模式 ======================
# 逻辑：先忽略目录下全部文件，再把需要追踪的后缀加回来
# 允许后缀：py md toml png jpg jpeg svg gif fcp txt log cff yaml yml json
/examples/**/*
!/examples/**/*.py
!/examples/**/*.md
!/examples/**/*.toml
!/examples/**/*.png
!/examples/**/*.jpg
!/examples/**/*.jpeg
!/examples/**/*.svg
!/examples/**/*.gif
!/examples/**/*.fcp
!/examples/**/*.txt
!/examples/**/*.log
!/examples/**/*.cff
!/examples/**/*.yaml
!/examples/**/*.yml
!/examples/**/*.json

/tutorial/**/*
!/tutorial/**/*.py
!/tutorial/**/*.md
!/tutorial/**/*.toml
!/tutorial/**/*.png
!/tutorial/**/*.jpg
!/tutorial/**/*.jpeg
!/tutorial/**/*.svg
!/tutorial/**/*.gif
!/tutorial/**/*.fcp
!/tutorial/**/*.txt
!/tutorial/**/*.log
!/tutorial/**/*.cff
!/tutorial/**/*.yaml
!/tutorial/**/*.yml
!/tutorial/**/*.json

/tests/**/*
!/tests/**/*.py
!/tests/**/*.md
!/tests/**/*.toml
!/tests/**/*.png
!/tests/**/*.jpg
!/tests/**/*.jpeg
!/tests/**/*.svg
!/tests/**/*.gif
