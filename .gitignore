# ====================== 根目录：原有黑名单规则保留 ======================
# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.omo
uv.lock

# Virtual environments
.venv
site/

# ====================== examples / examples-next / tutorial / tests：白名单模式 ======================
# 逻辑：先忽略目录下全部文件，再把需要追踪的后缀加回来
# 允许后缀：py md toml png jpg jpeg svg gif fcp txt log cff yaml yml json vasp extxyz

/tutorial/**/*
!/tutorial/**/
!/tutorial/**/*.py
!/tutorial/**/*.md
!/tutorial/**/*.toml
!/tutorial/**/*.png
!/tutorial/**/*.jpg
!/tutorial/**/*.jpeg
!/tutorial/**/*.svg
!/tutorial/**/*.gif
!/tutorial/**/*.fcp
!/tutorial/**/*.txt
!/tutorial/**/*.log
!/tutorial/**/*.cff
!/tutorial/**/*.yaml
!/tutorial/**/*.yml
!/tutorial/**/*.json
!/tutorial/**/*.vasp
!/tutorial/**/*.extxyz
!/tutorial/**/*.xyz
!/tutorial/**/BORN
# Tutorial force-constant models and external phonon/transport HDF5 outputs.
!/tutorial/**/*.hdf5

/tests/**/*
!/tests/**/*.py
!/tests/**/*.md
!/tests/**/*.toml
!/tests/**/*.png
!/tests/**/*.jpg
